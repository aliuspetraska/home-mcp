# Copy to .env (project root) and fill in.
# myUplink (NIBE) — create an application at https://dev.myuplink.com/apps
MYUPLINK_CLIENT_ID=
MYUPLINK_CLIENT_SECRET=

# Optional
MYUPLINK_LANGUAGE=en-GB
# 1 = do not register nibe_set_point / nibe_set_smart_home_mode
MYUPLINK_READ_ONLY=0

# Optional overrides
# MYUPLINK_BASE_URL=https://api.myuplink.com
# METEO_BASE_URL=https://api.meteo.lt/v1
# HOME_MCP_ENV_FILE=/path/to/.env
# HOME_MCP_HTTP_HOST=127.0.0.1
# HOME_MCP_HTTP_PORT=8000
